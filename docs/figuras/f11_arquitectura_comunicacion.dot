digraph G{ bgcolor=white; fontname="Helvetica"; node[fontname="Helvetica",fontsize=12,color="#00165C",fontcolor="#00165C",style="rounded,filled",fillcolor="#E8F0FF",shape=box]; edge[fontname="Helvetica",fontsize=10,color="#4F1FD0",fontcolor="#00165C"]; rankdir=LR; nodesep=.35; ranksep=.7; compound=true;
subgraph cluster_u{label="Unity (cliente)";fontcolor="#1060D0";color="#1060D0";style="rounded,dashed";
 UI[label="Interfaz del usuario\n(formulario, respuestas,\nvoz, negociación)"]; CS[label="ClienteServicio\nUnityWebRequest\nsondeo cada 1 s"]; RP[label="ReproductorSesion\ncola de eventos,\nvoz y navegación"]; UI->CS; CS->RP[label="eventos JSON"];}
subgraph cluster_s{label="Servicio de agentes (FastAPI + LangGraph)";fontcolor="#4F1FD0";color="#4F1FD0";style="rounded,dashed";
 API[label="API REST\n/sesiones, /respuestas,\n/negociacion, /condiciones,\n/sugerencia, /pitch/extraer,\n/audio, /voz"];
 subgraph cluster_g{label="Grafo de LangGraph: estado compartido (pizarra) + checkpointer";fontcolor="#4F1FD0";color="#4F1FD0";style="rounded";
  ST[label="Estado de la sesión\nhistorial público, ronda,\noferta, votos secretos",shape=cylinder,fillcolor="#FFF3BF"];
  MOD[label="Moderador\n(determinista)"]; T1[label="Tiburón 1"]; T2[label="Tiburón 2"]; T3[label="Tiburón 3"]; VOT[label="Nodo de votación\n(regla 2 de 3)"]; EMP[label="Emprendedor\n(usuario vía interrupt\no agente empresario)"];
  MOD->ST[label="turnos"]; T1->ST; T2->ST[label="pregunta, réplica\ny voto"]; T3->ST; ST->VOT[label="votos secretos"]; VOT->ST[label="DECISIÓN"]; EMP->ST[label="INFORM / ACCEPT"];
 }
 LLM[label="Azure OpenAI\ngpt-4.1-mini\nsalida estructurada (Pydantic)",shape=component,fillcolor="#E5DBFF"];
 VOZ[label="Voz local\nWindows SAPI (es-MX)\nWhisper (faster-whisper)",shape=component,fillcolor="#E5DBFF"];
 API->ST[label="invoke / Command(resume)",lhead=cluster_g]; T2->LLM[label="HTTPS",style=dashed]; API->VOZ[style=dashed];
}
CS->API[label="HTTP + JSON",color="#13B8F0",penwidth=2]; API->CS[label="eventos {n, tipo, emisor,\ndestino, texto}",color="#13B8F0",penwidth=2];
}