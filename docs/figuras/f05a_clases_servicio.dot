digraph G{ bgcolor=white; fontname="Helvetica"; node[fontname="Helvetica",fontsize=12,color="#00165C",fontcolor="#00165C",shape=record,style=filled]; edge[fontname="Helvetica",fontsize=10,color="#4F1FD0",fontcolor="#00165C"]; rankdir=TB; nodesep=.3; ranksep=.45;
Pitch[fillcolor="#F1ECFF",label="{Pitch|nombre, sector, etapa\lproblema, solucion\lequipo_*, discurso\lmonto_mxn, porcentaje\lventas_12m_mxn, margen_bruto_pct\l|valuacion_mxn()\les_hueco(campo)\ldiscurso()\l}"];
Panel[fillcolor="#F1ECFF",label="{«módulo»\nPanel|TAM_PANEL = 3\l|recomendar(pitch)\lorden_de_turnos()\lcriterios_no_evaluados()\l}"];
AgenteTiburon[fillcolor="#F1ECFF",label="{«módulo y nodos»\nAgenteTiburon|id, perfil, criterio, estilo\lpersona, personalidad\lcampos, palabras_clave\l|preguntar()\lreplicar()\lvotar()\lrevotar()\l(nivel: facil, medio, dificil)\l}"];
AgenteEmprendedor[fillcolor="#F1ECFF",label="{«nodos del grafo»\nAgenteEmprendedor|modo: humano, autopiloto, guion\l|responder(pregunta)\lsugerir(tiburon, borrador)\lnegociar()\lelegir_condiciones()\l}"];
Moderador[fillcolor="#F1ECFF",label="{«nodos del grafo»\nModerador|(lógica dentro de presentar,\lpreguntar y replicar)\l|orden_de_turnos()\l}"];
NodoVotacion[fillcolor="#F1ECFF",label="{«nodos del grafo»\nNodoVotacion|(nodos decidir y revotar)\l|primera_votacion()\lpuede_mantener_original()\lsegunda_votacion()\l}"];
GrafoSesion[fillcolor="#F1ECFF",label="{«grafo»\nGrafoSesion|Estado: pitch, panel, ronda,\lhistorial, votos, oferta\lcheckpointer MemorySaver\l|presentar()\lpreguntar()\lresponder() [interrupt]\lreplicar()\lvotar()\ldecidir()\lcondiciones()\lnegociar()\lrevotar()\lreporte()\l}"];
LLM[fillcolor="#F1ECFF",label="{LLM|llamadas, segundos\lAzure OpenAI gpt-4.1-mini\l|texto()\lestructurado(esquema)\l}"];
Sesion[fillcolor="#F1ECFF",label="{Sesion|eventos[], estado, pendiente\l|emit(evento)\liniciar()\lreanudar(valor)\lmetricas()\lguardar()\l}"];
API_FastAPI[fillcolor="#F1ECFF",label="{«módulo»\nAPI_FastAPI|/tiburones, /ejemplos, /panel\l/sesiones, /eventos\l/respuestas, /negociacion\l/condiciones, /reporte\l/sugerencia, /pitch/extraer\l/audio, /voz/transcribir\l|}"];
Voz[fillcolor="#F1ECFF",label="{«módulo»\nVoz|SAPI es-MX (texto a voz)\lWhisper base (voz a texto)\l|cargar_modelo()\lsintetizar(texto, emisor)\ltranscribir(wav)\l}"];
Extraer[fillcolor="#F1ECFF",label="{«módulo»\nExtraer|PitchExtraido (esquema)\ldocx, pdf, txt o texto\l|texto_de_archivo()\lextraer(llm, texto)\l}"];
Pitch->Panel; Panel->GrafoSesion; GrafoSesion->AgenteTiburon[label="3"]; GrafoSesion->AgenteEmprendedor; GrafoSesion->Moderador; GrafoSesion->NodoVotacion;
AgenteTiburon->LLM; AgenteEmprendedor->LLM[style=dashed,label="agente empresario"]; Sesion->GrafoSesion; Sesion->LLM; API_FastAPI->Sesion; API_FastAPI->Voz; API_FastAPI->Extraer; Extraer->LLM;
}