digraph G{ bgcolor=white; fontname="Helvetica"; node[fontname="Helvetica",fontsize=17,color="#00165C",fontcolor="#00165C",shape=record,style=filled]; edge[fontname="Helvetica",fontsize=15,color="#4F1FD0",fontcolor="#00165C"]; rankdir=TB; nodesep=.3; ranksep=.45;
